# Database (host Postgres — password must match the role created in step 1)
POSTGRES_PASSWORD=changeme

# Redis (host Redis — password must match requirepass in /opt/homebrew/etc/redis.conf)
REDIS_PASSWORD=changeme

# App secrets
SECRET_KEY=changeme-generate-a-random-string

# Encryption key (carry over from existing deployment)
ENCRYPTION_KEY=

# AI
ANTHROPIC_API_KEY=

# Gmail OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Twitter/X OAuth (optional)
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# Telegram MTProto (optional)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
